# Copiar como .env (raíz del proyecto) o src/.env y completar.
# Nunca subir el archivo .env al repositorio.

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Si se define, POST /api/auth/register exige el header x-admin-key con este valor
ADMIN_API_KEY=

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_MAX=20

# ─── Worker: envío al Ministerio ─────────────────────────────────────────────
WORKER_INTERVAL_SECONDS=60
WORKER_MAX_INTENTOS=5
WORKER_MAX_BATCH=100
WORKER_HTTP_TIMEOUT_MS=30000
LOG_LEVEL=info

# Autocorrección de displays: antes de enviar, el worker consulta /CodeSystem/{id}
# del Ministerio (con caché de 24 h) y reemplaza el display por el oficial.
# Reduce los rechazos "has incorrect display ... should be ...".
TERMINOLOGY_AUTOFIX=true
TERMINOLOGY_CACHE_HOURS=24
